{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian.dev/contracts/v1/desired-state.schema.json",
  "title": "Desired-state snapshot for one node",
  "type": "object",
  "additionalProperties": false,
  "required": ["node_id", "generation", "snapshot_hash", "assignments"],
  "properties": {
    "node_id": {"$ref": "common.schema.json#/$defs/opaque_id"},
    "generation": {"type": "integer", "minimum": 0},
    "snapshot_hash": {"$ref": "common.schema.json#/$defs/digest"},
    "assignments": {
      "type": "array",
      "items": {"$ref": "#/$defs/assignment"}
    },
    "jobs": {
      "description": "Batch job and service replicas for this node (DESIGN.md 25). Optional; absent means none.",
      "type": "array",
      "items": {"$ref": "#/$defs/job"}
    }
  },
  "$defs": {
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "replica", "kind", "image"],
      "properties": {
        "job_id": {"$ref": "common.schema.json#/$defs/opaque_id"},
        "replica": {"type": "integer", "minimum": 0},
        "kind": {"type": "string", "enum": ["job", "service"]},
        "image": {
          "description": "Digest-pinned image reference: <registry>/<repo>@sha256:<digest>",
          "type": "string",
          "maxLength": 512,
          "pattern": "@sha256:[0-9a-f]{64}$"
        },
        "args": {"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 8192}},
        "env": {
          "description": "Names NVIDIA_* (except NVIDIA_TF32_OVERRIDE), CUDA_VISIBLE_DEVICES and CUDA_MPS_* are reserved: the node sets GPU visibility. Values carry no NUL, CR or LF. A replica that breaks these rules is reported Failed/InvalidSpec.",
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
          "additionalProperties": {"type": "string", "maxLength": 8192}
        },
        "device_ids": {"type": "array", "items": {"type": "string", "maxLength": 128}},
        "memory_limit_bytes": {"description": "0 = the host's policy default cap. Above the host's maximum, the replica fails.", "type": "integer", "minimum": 0},
        "port": {"type": "integer", "minimum": 0, "maximum": 65535},
        "timeout_seconds": {"type": "integer", "minimum": 0},
        "desired_phase": {"type": "string", "enum": ["Running", "Draining", "Stopped"]}
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine_id", "node_id", "generation", "desired_phase", "engine", "artifact", "resources"],
      "properties": {
        "engine_id": {"$ref": "common.schema.json#/$defs/opaque_id"},
        "node_id": {"$ref": "common.schema.json#/$defs/opaque_id"},
        "generation": {"type": "integer", "minimum": 0},
        "spec_revision": {"type": "integer", "minimum": 0},
        "desired_phase": {"type": "string", "enum": ["Running", "Draining", "Stopped"]},
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "image_digest"],
          "properties": {
            "kind": {"type": "string", "enum": ["vllm", "sglang", "ollama", "openai-generic"]},
            "image_digest": {"$ref": "common.schema.json#/$defs/digest"},
            "version": {"type": "string", "maxLength": 64}
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_id", "revision", "manifest_digest", "engine_image_digest"],
          "properties": {
            "artifact_id": {"$ref": "common.schema.json#/$defs/opaque_id"},
            "revision": {"type": "string", "maxLength": 128},
            "manifest_digest": {"$ref": "common.schema.json#/$defs/digest"},
            "engine_image_digest": {"$ref": "common.schema.json#/$defs/digest"}
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["device_ids", "port"],
          "properties": {
            "device_ids": {"type": "array", "items": {"type": "string", "maxLength": 128}},
            "memory_limit_bytes": {"type": "integer", "minimum": 0},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "parameters": {"type": "object"},
        "policy": {
          "type": "object",
          "properties": {
            "restart": {
              "type": "object",
              "properties": {
                "max_attempts": {"type": "integer", "minimum": 0},
                "backoff_seconds": {"type": "integer", "minimum": 0}
              }
            },
            "drain_timeout_seconds": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
