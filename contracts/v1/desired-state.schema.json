{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian.dev/contracts/v1/desired-state.schema.json",
  "title": "Desired-state snapshot for one node",
  "type": "object",
  "additionalProperties": false,
  "required": ["node_id", "generation", "snapshot_hash", "assignments"],
  "properties": {
    "node_id": {"$ref": "common.schema.json#/$defs/opaque_id"},
    "generation": {"type": "integer", "minimum": 0},
    "snapshot_hash": {"$ref": "common.schema.json#/$defs/digest"},
    "assignments": {
      "type": "array",
      "items": {"$ref": "#/$defs/assignment"}
    },
    "jobs": {
      "description": "Batch job and service replicas for this node (DESIGN.md 25). Optional; absent means none.",
      "type": "array",
      "items": {"$ref": "#/$defs/job"}
    }
  },
  "$defs": {
    "job": {
      "description": "A job, service or task replica. `task` is present if and only if `kind` is \"task\"; a task's `port` is 0 and its `args` are the fixed runner command (docs/COMPUTE_TASKS_NODE.md).",
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "replica", "kind", "image"],
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "task"}}, "required": ["kind"]},
          "then": {
            "required": ["task"],
            "properties": {
              "port": {"const": 0},
              "args": {"const": ["python3", "-I", "-B", "/meridian/in/bundle/runner/meridian_runner.py"]}
            }
          },
          "else": {"not": {"required": ["task"]}}
        }
      ],
      "properties": {
        "job_id": {"$ref": "common.schema.json#/$defs/opaque_id"},
        "replica": {"type": "integer", "minimum": 0},
        "kind": {"type": "string", "enum": ["job", "service", "task"]},
        "task": {"$ref": "#/$defs/task"},
        "image": {
          "description": "Digest-pinned image reference: <registry>/<repo>@sha256:<digest>",
          "type": "string",
          "maxLength": 512,
          "pattern": "@sha256:[0-9a-f]{64}$"
        },
        "args": {"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 8192}},
        "env": {
          "description": "Names NVIDIA_* (except NVIDIA_TF32_OVERRIDE), CUDA_VISIBLE_DEVICES and CUDA_MPS_* are reserved: the node sets GPU visibility. Values carry no NUL, CR or LF. A replica that breaks these rules is reported Failed/InvalidSpec.",
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
          "additionalProperties": {"type": "string", "maxLength": 8192}
        },
        "device_ids": {"type": "array", "items": {"type": "string", "maxLength": 128}},
        "memory_limit_bytes": {"description": "0 = the host's policy default cap. Above the host's maximum, the replica fails.", "type": "integer", "minimum": 0},
        "port": {"type": "integer", "minimum": 0, "maximum": 65535},
        "timeout_seconds": {"type": "integer", "minimum": 0},
        "desired_phase": {"type": "string", "enum": ["Running", "Draining", "Stopped"]}
      }
    },
    "task": {
      "description": "A remote Python function call (Compute tasks, phase 1). The node fetches the bundle and payload by job_id and replica, verifies them against these digests and sizes, and runs the fixed runner command. Sent only to nodes whose capacity advertises task_protocols containing `protocol`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "bundle", "payload", "entry"],
      "properties": {
        "protocol": {"type": "integer", "minimum": 1},
        "bundle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["digest", "size_bytes"],
          "properties": {
            "digest": {"$ref": "common.schema.json#/$defs/digest"},
            "size_bytes": {"type": "integer", "minimum": 1, "maximum": 20971520}
          }
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["digest", "size_bytes"],
          "properties": {
            "digest": {"$ref": "common.schema.json#/$defs/digest"},
            "size_bytes": {"type": "integer", "minimum": 1, "maximum": 262144}
          }
        },
        "entry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["module", "qualname"],
          "properties": {
            "module": {"$ref": "#/$defs/entry_name"},
            "qualname": {"$ref": "#/$defs/entry_name"}
          }
        },
        "client_python": {"type": "string", "pattern": "^(3\\.[0-9]{1,2})?$"}
      }
    },
    "entry_name": {
      "description": "Dotted Python identifier path, ASCII only, at most 200 characters. No component may match ^__.*__$ (checked in code; not expressible here).",
      "type": "string",
      "maxLength": 200,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}(\\.[A-Za-z_][A-Za-z0-9_]{0,63}){0,15}$"
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine_id", "node_id", "generation", "desired_phase", "engine", "artifact", "resources"],
      "properties": {
        "engine_id": {"$ref": "common.schema.json#/$defs/opaque_id"},
        "node_id": {"$ref": "common.schema.json#/$defs/opaque_id"},
        "generation": {"type": "integer", "minimum": 0},
        "spec_revision": {"type": "integer", "minimum": 0},
        "desired_phase": {"type": "string", "enum": ["Running", "Draining", "Stopped"]},
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "image_digest"],
          "properties": {
            "kind": {"type": "string", "enum": ["vllm", "sglang", "ollama", "openai-generic"]},
            "image_digest": {"$ref": "common.schema.json#/$defs/digest"},
            "version": {"type": "string", "maxLength": 64}
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_id", "revision", "manifest_digest", "engine_image_digest"],
          "properties": {
            "artifact_id": {"$ref": "common.schema.json#/$defs/opaque_id"},
            "revision": {"type": "string", "maxLength": 128},
            "manifest_digest": {"$ref": "common.schema.json#/$defs/digest"},
            "engine_image_digest": {"$ref": "common.schema.json#/$defs/digest"}
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["device_ids", "port"],
          "properties": {
            "device_ids": {"type": "array", "items": {"type": "string", "maxLength": 128}},
            "memory_limit_bytes": {"type": "integer", "minimum": 0},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "parameters": {"type": "object"},
        "policy": {
          "type": "object",
          "properties": {
            "restart": {
              "type": "object",
              "properties": {
                "max_attempts": {"type": "integer", "minimum": 0},
                "backoff_seconds": {"type": "integer", "minimum": 0}
              }
            },
            "drain_timeout_seconds": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
